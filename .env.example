SECRET_KEY=cambiar-esta-clave-en-produccion
DATABASE_URL=sqlite:///instance/entradas.db

# Ya no se usan para cobrar (ver MP_CLIENT_ID/MP_CLIENT_SECRET abajo) — quedan por
# compatibilidad, se pueden dejar vacíos.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Client ID y Client Secret de tu aplicación de Mercado Pago (Developers > tu app >
# Credenciales — son distintos del Access Token). Con esto cada organizador conecta
# su propia cuenta y la plataforma cobra el recargo automáticamente.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# (El panel del dueño ya no usa ADMIN_EMAIL: la única cuenta de dueño se crea
#  desde la web la primera vez que se entra a /admin. Ver README.)

# URL pública donde corre la app (la necesita Mercado Pago para los redirects/webhook,
# y ahora también para el callback de OAuth). Los avisos automáticos de pago (webhook)
# solo funcionan con una dirección pública https, no con localhost.
BASE_URL=http://localhost:5000

# SMTP para mandarle las entradas por mail al comprador cuando se confirma el pago.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu Gmail, y
# SMTP_PASSWORD una "contraseña de aplicación" (no tu contraseña normal — hay que
# generarla en myaccount.google.com/apppasswords, requiere verificación en 2 pasos
# activada). Si se deja vacío, la app sigue funcionando igual, simplemente no manda
# el mail (el comprador siempre puede ver su entrada desde el link de la confirmación).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
