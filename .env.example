SECRET_KEY=cambiar-esta-clave-en-produccion
DATABASE_URL=sqlite:///instance/entradas.db

# Ya no se usan para cobrar (ver MP_CLIENT_ID/MP_CLIENT_SECRET abajo) — quedan por
# compatibilidad, se pueden dejar vacíos.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Client ID y Client Secret de tu aplicación de Mercado Pago (Developers > tu app >
# Credenciales — son distintos del Access Token). Con esto cada organizador conecta
# su propia cuenta y la plataforma cobra el recargo automáticamente.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Email del organizador que puede entrar a "Configuración" a cambiar el % de recargo.
ADMIN_EMAIL=

# URL pública donde corre la app (la necesita Mercado Pago para los redirects/webhook,
# y ahora también para el callback de OAuth)
BASE_URL=http://localhost:5000
